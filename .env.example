# sheetJEDI environment configuration (example)
# Copy to `.env` and adjust. NEVER commit the real `.env` file.

# --- Application ---
SHEETJEDI_ENV=development
SHEETJEDI_HOST=127.0.0.1
SHEETJEDI_PORT=8000
SHEETJEDI_LOG_LEVEL=INFO

# --- Database ---
# Default: local SQLite file (personal, local-first deployment).
# For PostgreSQL, use e.g.: postgresql+psycopg://user:password@localhost:5432/sheetjedi
SHEETJEDI_DATABASE_URL=sqlite:///./data/sheetjedi.db

# --- Security ---
# Fernet key used to encrypt stored provider API keys at rest (AES-128 + HMAC).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty in development, a key is generated into backend/data/.master_key (git-ignored).
# In production, SHEETJEDI_SECRET_KEY is REQUIRED.
SHEETJEDI_SECRET_KEY=

# Comma-separated list of allowed CORS origins (frontend dev server).
SHEETJEDI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File uploads ---
SHEETJEDI_MAX_UPLOAD_MB=10
SHEETJEDI_UPLOAD_RETENTION_MINUTES=60

# --- History / privacy ---
# Persist generated solutions to local history (can also be toggled in the UI).
SHEETJEDI_HISTORY_ENABLED=true

# --- Provider behavior ---
SHEETJEDI_PROVIDER_TIMEOUT_SECONDS=60
SHEETJEDI_MODEL_CACHE_TTL_SECONDS=900

# --- Rate limiting (in-memory, per client) ---
SHEETJEDI_RATE_LIMIT_ENABLED=true
SHEETJEDI_RATE_LIMIT_REQUESTS_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Provider API keys are NOT configured through environment variables.
# Configure them in the application UI (Settings -> AI Providers); they are
# stored encrypted in the local database and never returned to the frontend.
# ---------------------------------------------------------------------------
